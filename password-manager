info() {
	echo "[info] $1"
}
debug() {
	echo "[debug] $1"
}
error() {
	echo "[error] $1" >&2
}
fatal() {
	echo "[fatal] $1" >&2
	if [[ $2 -ne 0 ]]; then
		exit "$2"
	else
		exit 1
	fi
}
pressToContinue() {
	read -r -n 1 -p "Press any key to continue..."
}

DEFAULT_DATABASE_LOCATION="$HOME/.config/password_manager/"
DEFAULT_DATABASE_NAME="passwords.db"
FIRST_LOGIN=0

setupDB() {
	mkdir -p "$DEFAULT_DATABASE_LOCATION" 	|| fatal "Could not create '$DEFAULT_DATABASE_LOCATION'"  3
	cd "$DEFAULT_DATABASE_LOCATION"		|| fatal "Could not move to '$DEFAULT_DATABASE_LOCATION'" 3
	touch "$DEFAULT_DATABASE_NAME"		|| fatal "Could not create '$DEFAULT_DATABASE_NAME'"	  3
	
	sqlite3 "$DEFAULT_DATABASE_NAME" \
		"CREATE TABLE passwords (id INTEGER PRIMARY KEY, website TEXT NOT NULL, name TEXT NOT NULL, password TEXT NOT NULL)" \
		"CREATE TABLE config (salt TEXT NOT NULL, master_hash TEXT NOT NULL)"

	FIRST_LOGIN=1
}

newPassword() {
	local website=$1
	local name=$2
	local password=$3

	sqlite3 "$DEFAULT_DATABASE_NAME" \
		"INSERT INTO passwords (website, name, password) VALUES ('$website', '$name', '$password')"
}

saveUniversal() {
	local password=$1
	local salt 	; salt=$(openssl rand -base64 16)
	local crypted 	; crypted=$(argon2 "$salt" -id <<< "$password" | grep '^Hash:' | awk '{print $2}')

	sqlite3 "$DEFAULT_DATABASE_NAME" \
		"INSERT INTO config (salt, master_hash) VALUES ('$salt', '$crypted')"
}

checkMasterPwd() {
	local pwd_try=$1
	local salt	; salt=$(sqlite3 "$DEFAULT_DATABASE_NAME" "SELECT salt FROM config")
	local correct_pwd;correct_pwd=$(sqlite3 "$DEFAULT_DATABASE_NAME" "SELECT master_hash FROM config")

	pwd_try=$(argon2 "$salt" -id <<< "$pwd_try" | grep '^Hash:' | awk '{print $2}')

	if [[ $pwd_try == "$correct_pwd" ]]; then
		return 1
	else
		return 0
	fi
}

main() {
	clear

	sqlite3 --help &> /dev/null || fatal "'sqlite3' package is required but was not detected!" 2

	ls "$DEFAULT_DATABASE_LOCATION/$DEFAULT_DATABASE_NAME" &> /dev/null || setupDB

	local manager_pwd confirm_manager_pwd
	if [[ $FIRST_LOGIN -eq 1 ]]; then
		while true; do
			clear
			echo "First of all, let's create the password for this manager"
			echo "It'll be the only password you'll have to remember, so make sure it's secure!"
			echo
			read -rsp "Insert here your password: " manager_pwd
			echo
			read -rsp "Confirm your password: " confirm_manager_pwd
			echo

			if [[ $manager_pwd != "$confirm_manager_pwd" ]]; then
				error "The passwords must coincide"
				pressToContinue
				continue
			fi
			break
		done

		saveUniversal "$manager_pwd"
		echo
		echo "Password saved succesfully!"
		pressToContinue
	else
		cd "$DEFAULT_DATABASE_LOCATION" || fatal "Could not move to $!"

		local password_try
		while true; do
			clear
			read -rsp "Insert your master password: " password_try
			echo

			if checkMasterPwd "$password_try"; then
				echo
				error "Invalid password, try again..."
				pressToContinue
				continue
			fi
			break
		done
		debug "correct password"
	fi
	
	# show interface
	clear
	echo "WELCOME"
	echo

	return 0
}

main "$@"

