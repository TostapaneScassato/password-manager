DEFAULT_DATABASE_LOCATION="$HOME/.config/password_manager/"
DEFAULT_DATABASE_NAME="passwords.db"
MASTER_PASSWORD=
SAVED_PASSWORDS=
TMP_CIPHER=
TMP_DECIPHER=

# debug!!
#shopt -s expand_aliases
#alias "clear"=":"

info() {
	echo "[info] $1"
}
debug() {
	echo "[debug] $1"
}
warning() {
	echo "[attention] $1"
}
error() {
	echo "[error] $1" >&2
}
fatal() {
	echo "[fatal] $1" >&2
	if [[ $2 -ne 0 ]]; then
		exit "$2"
	else
		exit 1
	fi
}
pressToContinue() {
	read -r -n 1 -p "Press any key to continue..."
}

cleanup() {
	unset MASTER_PASSWORD
	clear
}
trap cleanup EXIT

firstLogin() {
	mkdir -p "$DEFAULT_DATABASE_LOCATION" 	|| fatal "Could not create '$DEFAULT_DATABASE_LOCATION'"  3
	cd "$DEFAULT_DATABASE_LOCATION"		|| fatal "Could not move to '$DEFAULT_DATABASE_LOCATION'" 3
	touch "$DEFAULT_DATABASE_NAME"		|| fatal "Could not create '$DEFAULT_DATABASE_NAME'"	  3
	
	sqlite3 "$DEFAULT_DATABASE_NAME" \
		"CREATE TABLE passwords (id INTEGER PRIMARY KEY, website TEXT, name TEXT, ciphertext TEXT);" \
		"CREATE TABLE config (salt TEXT NOT NULL, master_hash TEXT NOT NULL);"

	while true; do
		clear
		echo "First of all, let's create the password for this manager"
		echo "It'll be the only password you'll have to remember, so make sure it's secure!"
		echo
		read -rsp "Insert here your password: " MASTER_PASSWORD
		echo
		read -rsp "Confirm your password: " confirm_master_pwd
		echo

		if [[ $MASTER_PASSWORD != "$confirm_master_pwd" ]]; then
			error "The passwords must coincide"
			pressToContinue
			continue
		fi
		break
	done

	saveUniversal "$MASTER_PASSWORD"
	echo
	echo "Password saved succesfully!"
	pressToContinue
}

cipherPassword() {
	local password=$1

	TMP_CIPHER=$(echo "$password" | gpg --batch -q 			\
			--pinentry-mode loopback --passphrase-fd 3 	\
			-c --cipher-algo AES256 --s2k-mode 3 		\
			--s2k-digest-algo SHA512 			\
			--s2k-count 65011712 3<<< "$MASTER_PASSWORD" | base64 -w0)
}
decipherPassword() {
	local cipher=$1

	TMP_DECIPHER=$(echo "$cipher" | base64 -d | gpg --batch -q	\
			--pinentry-mode loopback --passphrase-fd 3	\
			--decrypt 3<<< "$MASTER_PASSWORD")
}

newPassword() {
	local website name password1 password2

	while true; do
		read -rp "Insert the website or service: " website
		if [[ -z $website ]]; then
			error "You must give a website or service!"
			pressToContinue
			echo -e  "\033[4A" # move cursor up 4 lines
			echo -ne "\033[0J" # clear terminal below cursor and don't print \n
			continue
		fi
		break
	done
	
	while true; do
		read -rp "Insert the username: " name
		if [[ -z $name ]]; then
			error "You must insert your username!"
			pressToContinue
			echo -ne "\033[3A\033[0J"
			continue
		fi
		break
	done

	while true; do
		read -rsp "Insert the password: " password1; echo
		if [[ -z $password1 ]]; then
			error "You must insert a password!"
			pressToContinue
			echo -ne "\033[3A\033[0J"
			continue
		fi

		read -rsp "Confirm the password: " password2; echo
		if [[ $password1 != "$password2" ]]; then
			error "The passwords must coincide!"
			pressToContinue
			echo -ne "\033[4A\033[0J"
			continue
		fi
		break
	done

	echo -n "Encrypting password... "
	local ciphertext
	cipherPassword "$password1"; ciphertext="$TMP_CIPHER"
	
	sqlite3 "$DEFAULT_DATABASE_NAME" \
		"INSERT INTO passwords (website, name, ciphertext) VALUES ('$website', '$name', '$ciphertext');"

	(( SAVED_PASSWORDS++ ))
	echo "done"
}

modifyPassword() {
	if [[ $SAVED_PASSWORDS -eq 0 ]]; then
		warning "There are no passwords to modify"
		pressToContinue
		return
	fi

	local idToModify flag
	while true; do
		clear
		echo "[Select password to modify]"
		sqlite3 "$DEFAULT_DATABASE_NAME" \
			"SELECT id, website, name FROM passwords"
		echo
		read -rp "Select the id of the password you'd like to modify: " idToModify
		
		flag=$(sqlite3 "$DEFAULT_DATABASE_NAME" "SELECT 1 FROM passwords WHERE id='$idToModify'")

		if [[ -z $flag ]]; then
			warning "Invalid id selected! Please try again"
			pressToContinue
			continue
		fi
		break
	done

	local password1 password2
	while true; do
		read -rsp "Insert the new password: " password1; echo
		if [[ -z $password1 ]]; then
			error "You must insert a password!"
			pressToContinue
			echo -ne "\033[3A\033[0J"
			continue
		fi

		read -rsp "Confirm the new password: " password2; echo
		if [[ $password1 != "$password2" ]]; then
			error "The passwords must coincide!"
			pressToContinue
			echo -ne "\033[4A\033[0J"
			continue
		fi
		break
	done

	echo -n "Encrypting password... "
	local ciphertext
	cipherPassword "$password1"; ciphertext="$TMP_CIPHER"

	sqlite3 "$DEFAULT_DATABASE_NAME" \
		"UPDATE passwords SET ciphertext='$ciphertext' WHERE id='$idToModify'"

	echo "done"
}

viewPassword() {
	if [[ $SAVED_PASSWORDS -eq 0 ]]; then
		info "There are no passwords to view"
		pressToContinue
		return
	fi

	local idToView flag
	while true; do
		clear
		echo "[3/Select password to view]"
		sqlite3 "$DEFAULT_DATABASE_NAME" \
			"SELECT id, website, name FROM passwords"
		echo
		read -rp "Select the id of the password you'd like to view: " idToView
		
		flag=$(sqlite3 "$DEFAULT_DATABASE_NAME" "SELECT 1 FROM passwords WHERE id='$idToView'")

		if [[ -z $flag ]]; then
			warning "Invalid id selected! Please try again"
			pressToContinue
			continue
		fi
		break
	done

	local website name cipher password
	website=$(sqlite3 -list "$DEFAULT_DATABASE_NAME" "SELECT website FROM passwords WHERE id='$idToView'")
	name=$(sqlite3 -list "$DEFAULT_DATABASE_NAME" "SELECT name FROM passwords WHERE id='$idToView'")
	cipher=$(sqlite3 -list "$DEFAULT_DATABASE_NAME" "SELECT ciphertext FROM passwords WHERE id='$idToView'")

	decipherPassword "$cipher"; password="$TMP_DECIPHER"

	echo "Make sure no one's watching the screen, are you ready?"
	pressToContinue
	clear
	echo "[3/View the password]"
	echo
	echo "Website:  $website"
	echo "Name:     $name"
	echo "Password: $password"
	echo
	pressToContinue
}

deletePassword() {
	if [[ $SAVED_PASSWORDS -eq 0 ]]; then
		info "There are no passwords to delete"
		pressToContinue
		return
	fi

	local idToDelete flag confirmation
	while true; do
		clear
		echo "[5/Select password to delete]"
		sqlite3 "$DEFAULT_DATABASE_NAME" \
			"SELECT id, website, name FROM passwords"
		echo
		read -rp "Select the id of the password you'd like to delete: " idToDelete
		
		flag=$(sqlite3 "$DEFAULT_DATABASE_NAME" "SELECT 1 FROM passwords WHERE id='$idToDelete'")

		if [[ -z $flag ]]; then
			warning "Invalid id selected! Please try again"
			pressToContinue
			continue
		fi
		break
	done

	echo "Are you sure? This action is irreversible!"
	read -rp "Type 'yes': " confirmation

	if [[ $confirmation == "yes" ]]; then
		sqlite3 "$DEFAULT_DATABASE_NAME" "DELETE FROM passwords WHERE id='$idToDelete'"
		(( SAVED_PASSWORDS-- ))
		info "Succesfully deleted password with id $idToDelete"
	else
		info "Operation canceled, no passwords were deleted"
	fi

	echo
	pressToContinue
}

saveUniversal() {
	local password=$1
	local salt 	; salt=$(openssl rand -base64 16)
	local crypted 	; crypted=$(argon2 "$salt" -id <<< "$password" | grep '^Hash:' | awk '{print $2}')

	sqlite3 "$DEFAULT_DATABASE_NAME" \
		"INSERT INTO config (salt, master_hash) VALUES ('$salt', '$crypted');"
}

checkMasterPwd() {
	local pwd_try=$1
	local salt	 ; salt=$(sqlite3 "$DEFAULT_DATABASE_NAME" "SELECT salt FROM config")
	local correct_pwd; correct_pwd=$(sqlite3 "$DEFAULT_DATABASE_NAME" "SELECT master_hash FROM config")

	pwd_try=$(argon2 "$salt" -id <<< "$pwd_try" | grep '^Hash:' | awk '{print $2}')

	if [[ $pwd_try == "$correct_pwd" ]]; then
		return 1
	else
		return 0
	fi
}


main() {
	clear

	sqlite3 --version &> /dev/null || fatal "'sqlite3' package is required but was not found!" 2
	! argon2  -h 	  &> /dev/null || fatal "'argon2' package is required but was not found!"  2
	openssl -v	  &> /dev/null || fatal "'openssl' package is required but was not found!" 2
	gpg --version	  &> /dev/null || fatal "'gpg' package is required but was not found!" 	   2

	ls "$DEFAULT_DATABASE_LOCATION/$DEFAULT_DATABASE_NAME" &> /dev/null ||firstLogin 
	cd "$DEFAULT_DATABASE_LOCATION" || fatal "Could not move to $!"

	SAVED_PASSWORDS=$(sqlite3 -list "$DEFAULT_DATABASE_NAME" "SELECT COUNT(*) FROM passwords")

	while true; do
		clear
		read -rsp "Insert your master password: " MASTER_PASSWORD
		echo

		if checkMasterPwd "$MASTER_PASSWORD"; then
			echo
			error "Invalid password, try again..."
			pressToContinue
			continue
		fi
		break
	done
	
	# show interface
	local choice
	while true; do
		clear
		echo "WELCOME"
		echo
		echo "What would you like to do?"
		echo "[1] Add a new password"
		echo "[2] Modify an existing password"
		echo "[3] View a password"
		echo "[4] View all entries (crypted)"
		echo "[5] Delete a password"
		echo "[6] Clear the database (/!\\)"
		echo "[0] Exit"

		read -rp "> " choice
		echo
		
		case $choice in
			1) newPassword    ; continue ;;
			2) modifyPassword ; continue ;;
			3) viewPassword   ; continue ;;
			4) 
				if [[ $SAVED_PASSWORDS -eq 0 ]]; then
					info "There are no passwords here, select [1] to save your first!"
				else
					sqlite3 "$DEFAULT_DATABASE_NAME" "SELECT * FROM passwords"
				fi
				echo
				pressToContinue
				continue
				;;
			5) deletePassword ; continue ;;
			6)
				warning "Are you sure? This will destroy all saved passwords, including the Master Password, forever (a very long time)!"
				read -rp "Write 'Destroy my database' to confirm: " destruction
				if [[ $destruction == "Destroy my database" ]]; then
					rm -r "$DEFAULT_DATABASE_LOCATION"
					firstLogin
				else
					info "Operation canceled, no harm was done :)"
				fi
				continue
				;;
			0) echo "See you later!" ; exit 0 ;;
			*) error "Invalid option" ; pressToContinue ; continue ;;
		esac
	done
}

main "$@"

